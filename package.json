{
  "name": "minclaw",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "fmt": "prettier --write \"**/*.{ts,json}\" --ignore-path .prettierignore",
    "test": "pnpm -r test",
    "test:host": "pnpm --filter minclaw-host test",
    "test:agent": "pnpm --filter minclaw-agent test",
    "test:coverage": "pnpm --filter minclaw-host exec vitest run --coverage && pnpm --filter minclaw-agent exec vitest run --coverage",
    "dev:host": "pnpm --filter minclaw-host dev",
    "dev:agent": "pnpm --filter minclaw-agent dev",
    "build": "agent/build.sh",
    "build:fresh": "agent/build.sh --base && agent/build.sh",
    "start": "./docker-compose.sh up -d && pnpm dev:host",
    "stop": "./docker-compose.sh down; kill $(lsof -ti:13821) 2>/dev/null; true",
    "reboot": "pnpm stop && pnpm build && pnpm start",
    "clear-jobs": "cd host && node --require tsx/cjs scripts/clear-jobs.ts",
    "clear-log": "rm -f log/minclaw-*.log"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "prettier": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
